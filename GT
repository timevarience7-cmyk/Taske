const LogWorkoutModal = ({ isOpen, onClose, onSave }) => {
  const [muscleGroup, setMuscleGroup] = useState('Push');
  const [workoutTitle, setWorkoutTitle] = useState('');
  const [durationMin, setDurationMin] = useState(50);
  const [exercises, setExercises] = useState([
    { name: 'Incline Dumbbell Press', sets: 3, reps: 10, weight: 26 },
    { name: 'Cable Chest Fly', sets: 3, reps: 12, weight: 12 }
  ]);

  if (!isOpen) return null;

  const addExerciseRow = () => {
    setExercises([...exercises, { name: '', sets: 3, reps: 10, weight: 20 }]);
  };

  const updateExercise = (index, field, value) => {
    const next = [...exercises];
    next[index][field] = value;
    setExercises(next);
  };

  const removeExercise = (index) => {
    if (exercises.length <= 1) return;
    setExercises(exercises.filter((_, i) => i !== index));
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    const finalTitle = workoutTitle.trim() || `${muscleGroup} Session`;
    const computedVolume = exercises.reduce((acc, ex) => {
      const sets = Number(ex.sets) || 0;
      const reps = Number(ex.reps) || 0;
      const weight = Number(ex.weight) || 0;
      return acc + sets * reps * weight;
    }, 0);

    const newWorkout = {
      id: 'w_' + Date.now(),
      date: getTodayString(),
      title: finalTitle,
      muscleGroup,
      durationMin: Number(durationMin) || 45,
      exercises: exercises.filter((ex) => ex.name.trim().length > 0),
      totalVolume: computedVolume
    };

    onSave(newWorkout);
    onClose();
  };

  const muscleOptions = ['Push', 'Pull', 'Legs', 'Upper', 'Lower', 'Cardio'];

