const ActivityRings = ({ movePercent, exercisePercent, standPercent, size = 180 }) => {
  const strokeWidth = 14;
  const gap = 4;
  const center = size / 2;

  // Radii for outer (Move/Workout), middle (Exercise/Diet), inner (Stand/Water)
  const r1 = center - strokeWidth / 2 - 4;
  const r2 = r1 - strokeWidth - gap;
  const r3 = r2 - strokeWidth - gap;

  const getCircleProps = (radius, percent) => {
    const circumference = 2 * Math.PI * radius;
    const clampedPercent = Math.min(Math.max(percent, 0), 100);
    const strokeDashoffset = circumference - (clampedPercent / 100) * circumference;
    return {
      circumference,
      strokeDashoffset,
      radius
    };
  };

  const ring1 = getCircleProps(r1, movePercent);
  const ring2 = getCircleProps(r2, exercisePercent);
  const ring3 = getCircleProps(r3, standPercent);

  return (
    <div className="relative flex items-center justify-center" style={{ width: size, height: size }}>
      <svg width={size} height={size} className="transform -rotate-90">
        {/* Track 1 (Red / Workout Minutes) */}
        <circle
          cx={center}
          cy={center}
          r={ring1.radius}
          fill="none"
          stroke="#FA114F"
          strokeWidth={strokeWidth}
          strokeOpacity="0.2"
        />
        {/* Fill 1 */}
        <circle
          cx={center}
          cy={center}
          r={ring1.radius}
          fill="none"
          stroke="url(#redGradient)"
          strokeWidth={strokeWidth}
          strokeDasharray={ring1.circumference}
          strokeDashoffset={ring1.strokeDashoffset}
          strokeLinecap="round"
          className="transition-all duration-700 ease-out"
        />

        {/* Track 2 (Green / Calorie Adherence) */}
        <circle
          cx={center}
          cy={center}
          r={ring2.radius}
          fill="none"
          stroke="#30D158"
          strokeWidth={strokeWidth}
          strokeOpacity="0.2"
        />
        {/* Fill 2 */}
        <circle
          cx={center}
          cy={center}
          r={ring2.radius}
          fill="none"
          stroke="url(#greenGradient)"
          strokeWidth={strokeWidth}
          strokeDasharray={ring2.circumference}
          strokeDashoffset={ring2.strokeDashoffset}
          strokeLinecap="round"
          className="transition-all duration-700 ease-out"
        />

        {/* Track 3 (Cyan / Water Adherence) */}
        <circle
          cx={center}
          cy={center}
          r={ring3.radius}
          fill="none"
          stroke="#0A84FF"
          strokeWidth={strokeWidth}
          strokeOpacity="0.2"
        />
        {/* Fill 3 */}
        <circle
          cx={center}
          cy={center}
          r={ring3.radius}
          fill="none"
          stroke="url(#blueGradient)"
          strokeWidth={strokeWidth}
          strokeDasharray={ring3.circumference}
          strokeDashoffset={ring3.strokeDashoffset}
          strokeLinecap="round"
          className="transition-all duration-700 ease-out"
        />

        <defs>
          <linearGradient id="redGradient" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stopColor="#FF375F" />
            <stop offset="100%" stopColor="#FF2D55" />
          </linearGradient>
          <linearGradient id="greenGradient" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stopColor="#30D158" />
            <stop offset="100%" stopColor="#28CD41" />
          </linearGradient>
          <linearGradient id="blueGradient" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stopColor="#0A84FF" />
            <stop offset="100%" stopColor="#64D2FF" />
          </linearGradient>
        </defs>
      </svg>
      {/* Activity Core Icon Badge */}
      <div className="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
        <Activity className="w-5 h-5 text-white/70" />
      </div>
    </div>
  );
};

