const WeightProgressChart = ({ data, targetWeight = 72 }) => {
  if (!data || data.length === 0) {
    return <div className="text-center py-8 text-neutral-500 text-sm">No weight logs yet</div>;
  }

  const weights = data.map((d) => d.weight);
  const minW = Math.min(...weights, targetWeight) - 0.5;
  const maxW = Math.max(...weights) + 0.5;
  const range = maxW - minW || 1;

  const svgWidth = 360;
  const svgHeight = 160;
  const paddingX = 35;
  const paddingY = 25;

  const getX = (index) => {
    if (data.length === 1) return svgWidth / 2;
    return paddingX + (index / (data.length - 1)) * (svgWidth - paddingX * 2);
  };

  const getY = (val) => {
    return svgHeight - paddingY - ((val - minW) / range) * (svgHeight - paddingY * 2);
  };

  const points = data.map((d, i) => `${getX(i)},${getY(d.weight)}`).join(' ');
  const targetY = getY(targetWeight);

  const [activePoint, setActivePoint] = useState(data[data.length - 1]);

  return (
    <div className="w-full">
      <div className="flex justify-between items-baseline mb-2 px-1">
        <div>
          <span className="text-2xl font-bold tracking-tight text-white">
            {activePoint ? activePoint.weight.toFixed(1) : data[data.length - 1].weight}{' '}
            <span className="text-sm font-medium text-[#8E8E93]">kg</span>
          </span>
          <span className="ml-2 text-xs font-medium text-[#30D158]">
            {activePoint ? activePoint.date : 'Current'}
          </span>
        </div>
        <div className="flex items-center space-x-2 text-xs text-[#8E8E93]">
          <span className="inline-block w-2.5 h-0.5 bg-[#0A84FF] rounded-full" />
          <span>Goal: {targetWeight} kg</span>
        </div>
      </div>

      <div className="relative overflow-hidden rounded-2xl bg-black/40 border border-white/5 p-2">
        <svg viewBox={`0 0 ${svgWidth} ${svgHeight}`} className="w-full h-44 overflow-visible">
          {/* Target Reference Line */}
          <line
            x1={paddingX}
            y1={targetY}
            x2={svgWidth - paddingX}
            y2={targetY}
            stroke="#0A84FF"
            strokeDasharray="4 4"
            strokeWidth="1.5"
            strokeOpacity="0.7"
          />

          {/* Fill under chart */}
          <defs>
            <linearGradient id="weightAreaGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stopColor="#FF9F0A" stopOpacity="0.35" />
              <stop offset="100%" stopColor="#FF9F0A" stopOpacity="0.0" />
            </linearGradient>
          </defs>

          {data.length > 1 && (
            <polygon
              points={`${getX(0)},${svgHeight - paddingY} ${points} ${getX(data.length - 1)},${svgHeight - paddingY}`}
              fill="url(#weightAreaGrad)"
            />
          )}

          {/* Line */}
          <polyline
            fill="none"
            stroke="#FF9F0A"
            strokeWidth="3"
            strokeLinecap="round"
            strokeLinejoin="round"
            points={points}
          />

          {/* Points */}
          {data.map((d, i) => {
            const cx = getX(i);
            const cy = getY(d.weight);
            const isSelected = activePoint && activePoint.id === d.id;
            return (
              <g
                key={d.id || i}
                className="cursor-pointer group"
                onClick={() => setActivePoint(d)}
              >
                <circle
                  cx={cx}
                  cy={cy}
                  r={isSelected ? 6 : 4}
                  fill={isSelected ? '#FFFFFF' : '#FF9F0A'}
                  stroke="#1C1C1E"
                  strokeWidth="2"
                  className="transition-all duration-200"
                />
              </g>
            );
          })}
        </svg>

        {/* Min / Max Footer */}
        <div className="flex justify-between items-center px-3 pt-2 text-[11px] text-[#8E8E93] border-t border-white/5">
          <span>Min: {Math.min(...weights)} kg</span>
          <span>Avg: {(weights.reduce((a, b) => a + b, 0) / weights.length).toFixed(1)} kg</span>
          <span>Max: {Math.max(...weights)} kg</span>
        </div>
      </div>
    </div>
  );
};

