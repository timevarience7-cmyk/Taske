const ExportSheetModal = ({ isOpen, onClose, stateData }) => {
  const [copied, setCopied] = useState(false);
  if (!isOpen) return null;

  const generateTextSummary = () => {
    const { workouts, meals, measurements, habits } = stateData;
    const latestW = measurements[measurements.length - 1];
    return `=== PULSE HEALTH SUMMARY REPORT ===
Date: ${getTodayString()}
Current Weight: ${latestW?.weight || 'N/A'} kg (Waist: ${latestW?.waist || 'N/A'} cm)
Total Workouts Logged: ${workouts.length}
Today's Logged Meals: ${meals.length}
Active Daily Habits: ${habits.filter((h) => h.enabled).length} of ${habits.length}
Latest Workout: ${workouts[workouts.length - 1]?.title || 'None'} (${workouts[workouts.length - 1]?.totalVolume || 0} kg volume)
Status: On Track (Consistency Streak Active)`;
  };

  const copyToClipboard = () => {
    navigator.clipboard.writeText(generateTextSummary());
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  const downloadJSON = () => {
    const blob = new Blob([JSON.stringify(stateData, null, 2)], {
      type: 'application/json'
    });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `pulse-health-backup-${getTodayString()}.json`;
    link.click();
    URL.revokeObjectURL(url);
  };

  return (
    <div className="fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 bg-black/80 backdrop-blur-md">
      <div className="bg-[#1C1C1E] border border-white/10 w-full max-w-md rounded-t-[28px] sm:rounded-3xl p-5 shadow-2xl">
        <div className="flex items-center justify-between pb-3 border-b border-white/10">
          <h3 className="text-base font-bold text-white flex items-center gap-2">
            <Share2 className="w-4 h-4 text-[#30D158]" /> Export & Coach Backup
          </h3>
          <button onClick={onClose} className="text-[#8E8E93] hover:text-white">
            <X className="w-4 h-4" />
          </button>
        </div>

        <p className="text-xs text-[#8E8E93] my-3">
          Share your weekly compliance and training metrics directly with your personal trainer or save a complete JSON backup.
        </p>

        <div className="bg-black/50 p-3 rounded-2xl border border-white/5 font-mono text-[11px] text-[#aeaeae] mb-4 overflow-x-auto whitespace-pre-wrap max-h-40">
          {generateTextSummary()}
        </div>

        <div className="grid grid-cols-2 gap-3">
          <button
            onClick={copyToClipboard}
            className="w-full bg-[#2C2C2E] hover:bg-[#3A3A3C] text-white font-semibold py-3 rounded-2xl text-xs flex items-center justify-center gap-2 border border-white/10 transition"
          >
            {copied ? <Check className="w-4 h-4 text-[#30D158]" /> : <Share2 className="w-4 h-4" />}
            {copied ? 'Copied to Clipboard' : 'Copy Summary'}
          </button>
          <button
            onClick={downloadJSON}
            className="w-full bg-[#0A84FF] hover:bg-[#0071e3] text-white font-semibold py-3 rounded-2xl text-xs flex items-center justify-center gap-2 transition"
          >
            <Download className="w-4 h-4" /> Save JSON File
          </button>
        </div>
      </div>
    </div>
  );
};

