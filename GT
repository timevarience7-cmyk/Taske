          <div className="w-10 h-10 rounded-2xl bg-[#0A84FF]/15 flex items-center justify-center text-[#0A84FF] mb-2 group-hover:bg-[#0A84FF] group-hover:text-white transition">
            <Scale className="w-5 h-5" />
          </div>
          <span className="text-xs font-bold text-white tracking-tight">Log Weight</span>
          <span className="text-[10px] text-[#8E8E93]">Waist & Body Fat</span>
        </button>
      </div>

      {/* Water Tracker Card */}
      <div className="rounded-3xl p-5 bg-[#1C1C1E] border border-white/10 shadow-lg">
        <div className="flex items-center justify-between mb-3">
          <div className="flex items-center space-x-2.5">
            <div className="w-9 h-9 rounded-2xl bg-[#0A84FF]/15 text-[#0A84FF] flex items-center justify-center">
              <Droplets className="w-5 h-5" />
            </div>
            <div>
              <h3 className="text-sm font-bold text-white">Daily Hydration</h3>
              <p className="text-xs text-[#8E8E93]">Target: 3,000 ml</p>
            </div>
          </div>
          <span className="text-base font-extrabold text-[#0A84FF]">{waterMl} ml</span>
        </div>

        {/* Liquid Progress Bar */}
        <div className="w-full bg-[#2C2C2E] h-3.5 rounded-full overflow-hidden p-0.5 border border-white/5 mb-3">
          <div
            style={{ width: `${Math.min((waterMl / 3000) * 100, 100)}%` }}
            className="h-full bg-gradient-to-r from-[#0A84FF] to-[#64D2FF] rounded-full transition-all duration-300"
          />
        </div>

        <div className="flex items-center justify-between gap-2">
          <div className="flex gap-2">
            <button
              onClick={() => addWater(250)}
              className="bg-[#2C2C2E] hover:bg-[#3A3A3C] active:scale-95 text-xs text-white font-semibold py-2 px-3 rounded-xl border border-white/5 transition flex items-center gap-1"
            >
              <Plus className="w-3.5 h-3.5 text-[#0A84FF]" /> 250 ml
            </button>
            <button
              onClick={() => addWater(500)}
              className="bg-[#2C2C2E] hover:bg-[#3A3A3C] active:scale-95 text-xs text-white font-semibold py-2 px-3 rounded-xl border border-white/5 transition flex items-center gap-1"
            >
              <Plus className="w-3.5 h-3.5 text-[#0A84FF]" /> 500 ml
            </button>
          </div>
          <button
            onClick={resetWater}
            className="text-[#8E8E93] hover:text-white text-xs px-2 py-1"
            title="Reset water for new day"
          >
            Reset
          </button>
        </div>
      </div>

      {/* Today's Meals Quick Preview */}
      <div className="rounded-3xl p-5 bg-[#1C1C1E] border border-white/10 shadow-lg">
        <div className="flex items-center justify-between mb-3">
          <span className="text-xs font-bold text-white uppercase tracking-wider">
            Today's Logged Meals
          </span>
          <span className="text-xs text-[#8E8E93]">{meals.length} entries</span>
        </div>
        <div className="space-y-2">
          {meals.map((m) => (
            <div
              key={m.id}
              className="flex items-center justify-between p-3 rounded-2xl bg-black/30 border border-white/5"
            >
              <div>
                <span className="text-xs font-semibold text-white block">{m.mealName}</span>
                <span className="text-[10px] text-[#8E8E93]">
                  P: {m.protein}g • C: {m.carbs}g • F: {m.fats}g
                </span>
              </div>
              <div className="text-right">
                <span className="text-xs font-bold text-[#FF9F0A] block">{m.calories} kcal</span>
                <span className="text-[9px] px-2 py-0.5 rounded-full bg-white/10 text-white font-medium">
                  {m.adherenceTag}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  );

  const renderWorkoutsTab = () => (
    <div className="space-y-5 animate-in fade-in">
      <div className="flex items-center justify-between px-1">
        <div>
          <h2 className="text-lg font-bold text-white">Training Sessions</h2>
          <p className="text-xs text-[#8E8E93]">Computed sets and progressive overload volume</p>
        </div>
        <button
          onClick={() => setIsWorkoutModalOpen(true)}
          className="bg-[#30D158] hover:bg-[#28CD41] text-black text-xs font-bold px-3.5 py-2 rounded-xl flex items-center gap-1.5 transition"
        >
          <Plus className="w-4 h-4 stroke-[2.5]" /> Log Workout
        </button>
      </div>

      {/* Workout History Cards */}
      <div className="space-y-3">
        {workouts.map((w) => (
          <div
            key={w.id}
            className="rounded-3xl p-5 bg-[#1C1C1E] border border-white/10 shadow-lg space-y-3"
          >
            <div className="flex items-start justify-between">
              <div>
                <div className="flex items-center space-x-2">
                  <span className="text-xs font-bold px-2 py-0.5 rounded-md bg-[#30D158]/20 text-[#30D158]">
                    {w.muscleGroup}
                  </span>
                  <span className="text-xs text-[#8E8E93] font-mono">{w.date}</span>
                </div>
                <h3 className="text-base font-bold text-white mt-1">{w.title}</h3>
              </div>
              <div className="text-right">
                <span className="text-xs font-bold text-[#30D158] block">
                  {w.totalVolume.toLocaleString()} kg
                </span>
                <span className="text-[10px] text-[#8E8E93]">{w.durationMin} mins duration</span>
              </div>
            </div>

            {/* Exercises table */}
            <div className="bg-black/30 rounded-2xl p-3 border border-white/5 space-y-2">
              {w.exercises.map((ex, i) => (
                <div key={i} className="flex justify-between items-center text-xs">
                  <span className="text-[#d1d1d6] font-medium">{ex.name}</span>
                  <span className="text-[#8E8E93] font-mono">
                    {ex.sets} sets × {ex.reps} reps @ <strong className="text-white">{ex.weight}kg</strong>
                  </span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  );

  const renderAnalyticsTab = () => {
    const totalVolumeMonth = workouts.reduce((acc, curr) => acc + (curr.totalVolume || 0), 0);
    const avgProtein = Math.round(
      meals.reduce((acc, curr) => acc + curr.protein, 0) / (meals.length || 1)
    );

    return (
      <div className="space-y-5 animate-in fade-in">
        {/* KPI Stats Top Grid */}
        <div className="grid grid-cols-2 gap-3">
          <div className="rounded-3xl p-4 bg-[#1C1C1E] border border-white/10 shadow-lg">
            <span className="text-xs font-semibold text-[#8E8E93] uppercase tracking-wider block mb-1">
              Monthly Volume
            </span>
            <span className="text-2xl font-extrabold text-white">
              {(totalVolumeMonth / 1000).toFixed(1)}k
            </span>
            <span className="text-xs text-[#30D158] block mt-0.5 font-semibold">kg lifted</span>
          </div>

          <div className="rounded-3xl p-4 bg-[#1C1C1E] border border-white/10 shadow-lg">
            <span className="text-xs font-semibold text-[#8E8E93] uppercase tracking-wider block mb-1">
              Consistency Score
            </span>
            <span className="text-2xl font-extrabold text-[#30D158]">94%</span>
            <span className="text-xs text-[#8E8E93] block mt-0.5">Top 5% compliance</span>
          </div>
        </div>

        {/* Body Weight Progress Chart */}
        <div className="rounded-3xl p-5 bg-[#1C1C1E] border border-white/10 shadow-lg">
          <div className="flex items-center justify-between mb-2">
            <div className="flex items-center space-x-2">
              <Scale className="w-5 h-5 text-[#FF9F0A]" />
              <h3 className="text-sm font-bold text-white">Body Weight Trajectory</h3>
            </div>
            <button
              onClick={() => setIsMeasurementModalOpen(true)}
              className="text-xs text-[#0A84FF] font-semibold hover:underline"
            >
              + Log New
            </button>
          </div>
          <WeightProgressChart data={measurements} targetWeight={72} />
        </div>

        {/* Weekly Workout Adherence Chart */}
        <div className="rounded-3xl p-5 bg-[#1C1C1E] border border-white/10 shadow-lg">
          <WeeklyWorkoutBars workouts={workouts} />
        </div>

        {/* Macro Distribution */}
        <div className="rounded-3xl p-5 bg-[#1C1C1E] border border-white/10 shadow-lg">
          <div className="flex items-center justify-between mb-3">
            <div className="flex items-center space-x-2">
              <Utensils className="w-5 h-5 text-[#FF375F]" />
              <h3 className="text-sm font-bold text-white">Daily Macro Adherence</h3>
            </div>
            <button
              onClick={() => setIsDietModalOpen(true)}
              className="text-xs text-[#FF9F0A] font-semibold hover:underline"
            >
              + Log Meal
            </button>
          </div>
          <MacroNutrientBalance meals={meals} />
        </div>
      </div>
    );
  };

  return (
    <div className="min-h-screen bg-black text-[#F2F2F7] font-sans antialiased selection:bg-[#30D158]/30 selection:text-white pb-28">
      {/* Simulated iOS Dynamic Push Notification */}
      <IOSPushBanner
        notification={notification}
        onClose={() => setNotification(null)}
      />

      {/* Main Container */}
      <div className="max-w-md sm:max-w-xl md:max-w-2xl mx-auto px-4 pt-5 pb-6">
        {/* iOS Frosted Navigation Bar */}
        <header className="flex items-center justify-between mb-6 pb-2 border-b border-white/10">
          <div>
            <span className="text-[10px] font-extrabold uppercase tracking-widest text-[#8E8E93] block">
              PULSE FITNESS • IOS SYSTEM
            </span>
            <h1 className="text-2xl font-black tracking-tight text-white flex items-center gap-1.5">
              Summary <span className="w-2 h-2 rounded-full bg-[#30D158]" />
            </h1>
          </div>
          <div className="flex items-center space-x-2">
            <button
              onClick={() => setIsExportModalOpen(true)}
              className="w-10 h-10 rounded-full bg-[#1C1C1E] border border-white/10 text-white flex items-center justify-center hover:bg-[#2C2C2E] transition active:scale-95"
              title="Export Report & Backup"
            >
              <Share2 className="w-4 h-4" />
            </button>
            <div className="w-10 h-10 rounded-full bg-gradient-to-tr from-[#30D158] to-[#0A84FF] p-0.5 flex items-center justify-center">
              <div className="w-full h-full rounded-full bg-black flex items-center justify-center text-xs font-bold text-white">
                ME
              </div>
            </div>
          </div>
        </header>

        {/* Tab Views */}
        <main>
          {activeTab === 'today' && renderTodayTab()}
          {activeTab === 'workouts' && renderWorkoutsTab()}
          {activeTab === 'analytics' && renderAnalyticsTab()}
          {activeTab === 'checkin' && (
            <WeeklyReviewTab
              workouts={workouts}
              meals={meals}
              measurements={measurements}
              checkins={checkins}
              onAddCheckin={(c) => {
                setCheckins([c, ...checkins]);
                triggerNotification('Check-in Logged! 🏆', 'Great work completing your weekly accountability audit.');
              }}
            />
          )}
          {activeTab === 'habits' && (
            <HabitsManagerTab
              habits={habits}
              onToggleHabit={handleToggleHabit}
              onAddHabit={handleAddHabit}
              onTriggerTestPush={handleTriggerTestPush}
            />
          )}
        </main>
      </div>

      {/* Floating Bottom iOS Tab Bar */}
      <nav className="fixed bottom-0 left-0 right-0 z-40 backdrop-blur-2xl bg-black/85 border-t border-white/10 px-4 py-2">
        <div className="max-w-md sm:max-w-xl md:max-w-2xl mx-auto flex items-center justify-between">
          <button
            onClick={() => setActiveTab('today')}
            className={`flex flex-col items-center flex-1 py-1 transition ${
              activeTab === 'today' ? 'text-[#30D158]' : 'text-[#8E8E93] hover:text-white'
            }`}
          >
            <Activity className="w-5 h-5" />
            <span className="text-[10px] font-semibold mt-1">Today</span>
          </button>

          <button
            onClick={() => setActiveTab('workouts')}
            className={`flex flex-col items-center flex-1 py-1 transition ${
              activeTab === 'workouts' ? 'text-[#30D158]' : 'text-[#8E8E93] hover:text-white'
            }`}
          >
            <Dumbbell className="w-5 h-5" />
            <span className="text-[10px] font-semibold mt-1">Workouts</span>
          </button>

          <button
            onClick={() => setActiveTab('analytics')}
            className={`flex flex-col items-center flex-1 py-1 transition ${
              activeTab === 'analytics' ? 'text-[#30D158]' : 'text-[#8E8E93] hover:text-white'
            }`}
          >
            <TrendingUp className="w-5 h-5" />
            <span className="text-[10px] font-semibold mt-1">Analytics</span>
          </button>

          <button
            onClick={() => setActiveTab('checkin')}
            className={`flex flex-col items-center flex-1 py-1 transition ${
              activeTab === 'checkin' ? 'text-purple-400' : 'text-[#8E8E93] hover:text-white'
            }`}
          >
            <Sparkles className="w-5 h-5" />
            <span className="text-[10px] font-semibold mt-1">Check-in</span>
          </button>

          <button
            onClick={() => setActiveTab('habits')}
            className={`flex flex-col items-center flex-1 py-1 transition ${
              activeTab === 'habits' ? 'text-[#0A84FF]' : 'text-[#8E8E93] hover:text-white'
            }`}
          >
            <Bell className="w-5 h-5" />
            <span className="text-[10px] font-semibold mt-1">Habits</span>
          </button>
        </div>
      </nav>

      {/* Modals & Dialogs */}
      <LogWorkoutModal
        isOpen={isWorkoutModalOpen}
        onClose={() => setIsWorkoutModalOpen(false)}
        onSave={(w) => {
          setWorkouts([w, ...workouts]);
          triggerNotification('Workout Session Logged! 💪', `${w.title} (${w.totalVolume.toLocaleString()} kg total volume).`);
        }}
      />

      <LogDietModal
        isOpen={isDietModalOpen}
        onClose={() => setIsDietModalOpen(false)}
        onSave={(m) => {
          setMeals([...meals, m]);
          triggerNotification('Meal Added 🥗', `${m.mealName} (${m.calories} kcal, ${m.protein}g protein).`);
        }}
      />

      <LogMeasurementModal
        isOpen={isMeasurementModalOpen}
        onClose={() => setIsMeasurementModalOpen(false)}
        lastWeight={measurements[measurements.length - 1]?.weight || 75.9}
        onSave={(entry) => {
          setMeasurements([...measurements, entry]);
          triggerNotification('Body Metrics Saved ⚖️', `Logged ${entry.weight} kg. Your trendline has been updated.`);
        }}
      />

      <ExportSheetModal
        isOpen={isExportModalOpen}
        onClose={() => setIsExportModalOpen(false)}
        stateData={{ workouts, meals, measurements, checkins, habits, waterMl }}
      />
    </div>
  );
}
